---
// stylesheet
import "../styles/global.css";

// components
import BaseHead from "../components/global/BaseHead.astro";
import Wrapper from "../components/global/Wrapper.astro";
import NavBar from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

import background from "../assets/images/casetta-background.jpg";
import { getImage } from "astro:assets";

const backgroundImage = await getImage({ src: background, format: "webp" });

// props
const {title, description, titleTemplate, siteName, ogImage, twitterSite, themeColor, locale, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="it" class="scroll-smooth">
	<BaseHead 
		title={title}
      	description={description}
      	titleTemplate={titleTemplate}
    	siteName={siteName}
      	ogImage={ogImage}
      	twitterSite={twitterSite}
      	themeColor={themeColor}
      	locale={locale}
      	{...seoProps}
	/>
	<body
		style={`background-image: url(${backgroundImage.src})`}
		class="min-h-screen bg-base-100 bg-cover bg-center bg-no-repeat bg-fixed box-border"
	>
		<!-- Background noise effect -->
		<!-- Wrapper component to make sure all content on the website is above the noise filter background -->
		<Wrapper>
			<NavBar />
			<main class="page-enter flex flex-col xl:gap-48 lg:gap-40 gap-28">
				<slot />
			</main>
			<Footer />
		</Wrapper>
	</body>
</html>
